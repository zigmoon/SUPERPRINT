---
/**
 * Pied de page des pages marketing.
 *
 * Trois variantes cohabitent dans le site d'origine :
 *   • accueil / FAQ — colonne « Navigation », liens vers les ancres de
 *     l'accueil, mentions légales en pop-ins, pas de ressources de presse ;
 *   • tarif — colonne « Bureau SuperPrint », liens vers `index.html#…`,
 *     valise logo + dossier de presse, mentions légales en ancres ;
 *   • ROCK v1 — comme le tarif, sans les liens « Auteurs », avec sa version.
 */
import { VERSION } from '../data/site';
import type { Footer } from '../lib/layout';

const {
  faqHref = 'faq.html',
  featuresHref = '#features',
  authorsHref = '#auteurs',
  heading = { fr: 'Navigation', en: 'Navigation', ja: 'ナビゲーション' },
  version = VERSION,
  pressKit = false,
  legal = 'overlays',
} = Astro.props as Footer;
---

<footer>
  <div class="container">
    <div class="foot-brand">
      <a class="foot-logo" href="index.html">SUPERPRINT</a>
      <p class="inline-fr">Un bureau de mise en page professionnelle, né pour la presse et l'édition — dans votre navigateur.</p>
      <p class="inline-en">A professional layout desk, born for print and publishing — in your browser.</p>
      <p class="inline-ja">印刷と出版のために生まれたプロのレイアウトデスク — ブラウザの中で。</p>
      <!-- 🆕 v1.7.472 — les deux auteurs, dans le colophon : ils ne coûtent pas une ligne de
           plus et ils disent qui publie. Le copyright les nomme aussi, plus bas. -->
      <p class="foot-auteurs">Simon Dupont-Gellert &amp; Clémence Brunet</p>
    </div>
    <div class="foot-cols">
      <div>
        <h4 data-lang="fr">{heading.fr}</h4>
        <h4 data-lang="en">{heading.en}</h4>
        <h4 data-lang="ja">{heading.ja}</h4>
        <div class="foot-links">
          <a href="app/index.html">SuperPrint Editor</a>
          <a href="sp213-studio.html" data-lang="fr">Studio SP213</a>
          <a href="sp213-studio.html" data-lang="en">SP213 Studio</a>
          <a href="sp213-studio.html" data-lang="ja">SP213スタジオ</a>
          <a href="supertypo/index.html">SuperTyPo</a>
          <a href="rock.html" data-lang="fr">Moteur ROCK v1</a>
          <a href="rock.html" data-lang="en">ROCK v1 engine</a>
          <a href="rock.html" data-lang="ja">ROCK v1 エンジン</a>
          <a href={featuresHref} data-lang="fr">Fonctions</a>
          <a href={featuresHref} data-lang="en">Features</a>
          <a href={featuresHref} data-lang="ja">機能</a>
          <a href="documentation.html" data-lang="fr">Manuel</a>
          <a href="documentation.html" data-lang="en">Manual</a>
          <a href="documentation.html" data-lang="ja">マニュアル</a>
          {authorsHref !== null && (
            <>
              <a href={authorsHref} data-lang="fr">Auteurs</a>
              <a href={authorsHref} data-lang="en">Authors</a>
              <a href={authorsHref} data-lang="ja">著者</a>
            </>
          )}
          <a href={faqHref} data-lang="fr">Questions fréquentes</a>
          <a href={faqHref} data-lang="en">FAQ</a>
          <a href={faqHref} data-lang="ja">よくある質問</a>
          <a href="price.html" data-lang="fr">Tarif</a>
          <a href="price.html" data-lang="en">Price</a>
          <a href="price.html" data-lang="ja">料金</a>
        </div>
      </div>
      <div>
        <h4 data-lang="fr">Le projet</h4>
        <h4 data-lang="en">The project</h4>
        <h4 data-lang="ja">プロジェクト</h4>
        <div class="foot-links">
          <a href="https://zigmoon.com">zigmoon.com</a>
          <a href="https://app.zigmoon.com/release.html" data-lang="fr">Journal des versions</a>
          <a href="https://app.zigmoon.com/release.html" data-lang="en">Changelog</a>
          <a href="https://app.zigmoon.com/release.html" data-lang="ja">変更履歴</a>
          <a href="https://x.com/SUPER_PRINT_app" rel="noopener noreferrer" target="_blank">@SUPER_PRINT_app</a>
          {pressKit && (
            <>
              <!-- 🆕 v1.7.580tt — ressources téléchargeables, rangées au premier niveau de
                   superprint/ : la valise logo (ZIP) et le dossier de presse (PDF). -->
              <a href="logos_superprint.zip" download data-lang="fr">Valise logo (SVG + PNG)</a>
              <a href="logos_superprint.zip" download data-lang="en">Logo kit (SVG + PNG)</a>
              <a href="logos_superprint.zip" download data-lang="ja">ロゴ一式（SVG・PNG）</a>
              <a href="dossier_de_presse_superprint.pdf" target="_blank" rel="noopener" data-lang="fr">Dossier de presse (PDF)</a>
              <a href="dossier_de_presse_superprint.pdf" target="_blank" rel="noopener" data-lang="en">Press kit (PDF)</a>
              <a href="dossier_de_presse_superprint.pdf" target="_blank" rel="noopener" data-lang="ja">プレスキット（PDF）</a>
            </>
          )}
        </div>
      </div>
    </div>
    <div class="foot-copy">
      <span>© 2026 Simon Dupont-Gellert &amp; Clémence Brunet — SuperPrint v{version}</span>
      <!-- 🆕 v1.7.679 — RANGÉE SOCIALE DU COLOPHON. GitHub d'abord, Discord à sa
           droite : c'est l'ordre demandé. Les deux traces sont EN LIGNE (et non des
           <img>) parce que le pied de page est sur fond d'encre et que les fichiers
           icons/*.svg portent une couleur cuite : chargés par <img>, ils seraient
           invisibles ici. En ligne, ils suivent currentColor, survol compris. -->
      <div class="foot-social">
        <a href="https://github.com/zigmoon/SUPERPRINT" target="_blank" rel="noopener noreferrer" aria-label="GitHub — zigmoon/SUPERPRINT" title="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
        <!-- Trace OFFICIEL de Discord, extrait de simple-icons (CC0-1.0), recopie tel quel.
             « discord.gg/B8EXBY8P » est l'invitation du serveur. -->
        <a href="https://discord.gg/B8EXBY8P" target="_blank" rel="noopener noreferrer" aria-label="Discord — discord.gg/B8EXBY8P" title="Discord">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
        </a>
      </div>
      <div class="foot-legal">
        {legal === 'overlays' ? (
          <>
            <a href="#" onclick="event.preventDefault();openLegal('legalOverlay');return false;" data-lang="fr">Mentions légales</a>
            <a href="#" onclick="event.preventDefault();openLegal('legalOverlay');return false;" data-lang="en">Legal notice</a>
            <a href="#" onclick="event.preventDefault();openLegal('legalOverlay');return false;" data-lang="ja">法的情報</a>
            <span class="sep" aria-hidden="true">·</span>
            <a href="#" onclick="event.preventDefault();openLegal('privacyOverlay');return false;" data-lang="fr">Confidentialité</a>
            <a href="#" onclick="event.preventDefault();openLegal('privacyOverlay');return false;" data-lang="en">Privacy</a>
            <a href="#" onclick="event.preventDefault();openLegal('privacyOverlay');return false;" data-lang="ja">プライバシー</a>
          </>
        ) : (
          <>
            <a href="index.html#legal" data-lang="fr">Mentions légales</a>
            <a href="index.html#legal" data-lang="en">Legal notice</a>
            <a href="index.html#legal" data-lang="ja">法的情報</a>
            <span class="sep" aria-hidden="true">·</span>
            <a href="index.html#privacy" data-lang="fr">Confidentialité</a>
            <a href="index.html#privacy" data-lang="en">Privacy</a>
            <a href="index.html#privacy" data-lang="ja">プライバシー</a>
          </>
        )}
      </div>
      <span class="foot-note" data-lang="fr">SuperPrint est un projet indépendant de Zigmoon. Les marques citées appartiennent à leurs détenteurs.</span>
      <span class="foot-note" data-lang="en">SuperPrint is an independent project by Zigmoon. All trademarks belong to their owners.</span>
      <span class="foot-note" data-lang="ja">SuperPrintはZigmoonの独立プロジェクトです。商標はすべて各権利者に帰属します。</span>
    </div>
  </div>
</footer>

<style>
  /* 🆕 v1.7.679 — Styles de la rangée sociale, portés par le composant lui-même.
     ⚠️ PAS DANS LES CINQ FEUILLES DE PAGE. Le pied de page est partagé par
     l'accueil, la FAQ, le tarif et ROCK, et chacune a sa propre copie des règles
     de pied de page : y ajouter ces quatre sélecteurs aurait fait cinq copies à
     garder alignées. En portée de composant, Astro les applique une fois, et
     seulement aux éléments de ce fichier. */
  .foot-social { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .foot-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border: 1px solid rgba(247,243,236,.22);
    color: var(--muted); transition: color .25s var(--ease), background .25s var(--ease), border-color .25s var(--ease);
  }
  .foot-social a:hover, .foot-social a:focus-visible {
    color: var(--ink); background: var(--paper); border-color: var(--paper);
  }
  .foot-social svg { display: block; width: 17px; height: 17px; }
</style>
