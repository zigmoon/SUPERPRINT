---
/**
 * « Téléchargement » — la dernière zone avant le pied de page.
 *
 * ELLE NE DOUBLE PAS LES TROIS ENTRÉES DE L'ACCUEIL, elle les prolonge : les
 * entrées, en haut de page, ouvrent l'application en ligne et ne disent rien des
 * versions. Ici on donne le numéro de version, les trois systèmes et l'accès au
 * téléchargement — ce que le visiteur venu en bas de page est venu chercher.
 *
 * ELLE EST POSÉE SUR LE FOND DE PAGE : aucun panneau blanc, aucun filet de
 * couleur. Trois aplats encadrés faisaient trois cartes là où il n'y a que trois
 * logiciels — l'œil lisait le cadre, pas le nom.
 *
 * LE BOUTON N'ÉNUMÈRE PAS LES FICHIERS. Il ouvre le menu « Télécharger » de la
 * barre, qui reste la seule liste d'adresses du site — donc la seule à corriger le
 * jour où un nom de paquet change. Le script est dans `JS/marketing/lang-switcher.js`.
 */
import {
  APPLICATIONS_BUREAU,
  DOWNLOAD_LABELS,
  RELEASE_URL,
  SYSTEMES,
  VERSIONS_LABELS,
  VERSION,
} from '../data/site';
---

<section id="logiciels" aria-labelledby="lg-titre">
  <div class="container">
    <div class="lg-head">
      <div class="hero-kicker" data-lang="fr">{VERSIONS_LABELS.kicker.fr}</div>
      <div class="hero-kicker" data-lang="en">{VERSIONS_LABELS.kicker.en}</div>
      <div class="hero-kicker" data-lang="ja">{VERSIONS_LABELS.kicker.ja}</div>
      <h2 id="lg-titre" data-lang="fr">{VERSIONS_LABELS.titre.fr}</h2>
      <h2 data-lang="en">{VERSIONS_LABELS.titre.en}</h2>
      <h2 data-lang="ja">{VERSIONS_LABELS.titre.ja}</h2>
      <p class="lead" data-lang="fr">{VERSIONS_LABELS.chapeau.fr}</p>
      <p class="lead" data-lang="en">{VERSIONS_LABELS.chapeau.en}</p>
      <p class="lead" data-lang="ja">{VERSIONS_LABELS.chapeau.ja}</p>
    </div>

    <div class="lg-grid">
      {
        APPLICATIONS_BUREAU.map((app) => (
          <article class="lg-app">
            <div class="lg-tete">
              <span class={app.plaqueClaire ? 'lg-logo lg-logo-clair' : 'lg-logo'}>
                <img src={app.logo} alt="" width="50" height="50" loading="lazy" decoding="async" />
              </span>
              <div class="lg-id">
                <h3 class="lg-nom">{app.nom}</h3>
                <span class="lg-role">
                  <span class="inline-fr">{app.role.fr}</span>
                  <span class="inline-en">{app.role.en}</span>
                  <span class="inline-ja">{app.role.ja}</span>
                </span>
              </div>
            </div>
            <p class="lg-desc" data-lang="fr">{app.resume.fr}</p>
            <p class="lg-desc" data-lang="en">{app.resume.en}</p>
            <p class="lg-desc" data-lang="ja">{app.resume.ja}</p>
            <div class="lg-ver">
              <span data-lang="fr">{VERSIONS_LABELS.version.fr}</span>
              <span data-lang="en">{VERSIONS_LABELS.version.en}</span>
              <span data-lang="ja">{VERSIONS_LABELS.version.ja}</span>
              <b>v{VERSION}</b>
            </div>
            <div class="lg-os">
              {SYSTEMES.map((os) => (
                <i>
                  <img src={os.marque} alt="" width="14" height="14" loading="lazy" decoding="async" />
                  {os.nom}
                </i>
              ))}
            </div>
            <div class="lg-actions">
              <button type="button" class="btn btn-primary" data-ouvre-telechargement>
                <span class="inline-fr">{DOWNLOAD_LABELS.bouton.fr}</span>
                <span class="inline-en">{DOWNLOAD_LABELS.bouton.en}</span>
                <span class="inline-ja">{DOWNLOAD_LABELS.bouton.ja}</span>
              </button>
              <a class="btn btn-secondary" href={app.enLigne}>
                <span class="inline-fr">{DOWNLOAD_LABELS.enLigne.fr}</span>
                <span class="inline-en">{DOWNLOAD_LABELS.enLigne.en}</span>
                <span class="inline-ja">{DOWNLOAD_LABELS.enLigne.ja}</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="lg-note" data-lang="fr">
      {VERSIONS_LABELS.note.fr.avant}<strong>{VERSIONS_LABELS.note.fr.gras}</strong>{VERSIONS_LABELS.note.fr.apres}{' '}
      <a href={RELEASE_URL} target="_blank" rel="noopener">{VERSIONS_LABELS.voirVersions.fr} →</a>
    </p>
    <p class="lg-note" data-lang="en">
      {VERSIONS_LABELS.note.en.avant}<strong>{VERSIONS_LABELS.note.en.gras}</strong>{VERSIONS_LABELS.note.en.apres}{' '}
      <a href={RELEASE_URL} target="_blank" rel="noopener">{VERSIONS_LABELS.voirVersions.en} →</a>
    </p>
    <p class="lg-note" data-lang="ja">
      {VERSIONS_LABELS.note.ja.avant}<strong>{VERSIONS_LABELS.note.ja.gras}</strong>{VERSIONS_LABELS.note.ja.apres}{' '}
      <a href={RELEASE_URL} target="_blank" rel="noopener">{VERSIONS_LABELS.voirVersions.ja} →</a>
    </p>

    <!-- 🆕 v1.7.613 — CE BLOC A QUITTÉ LA COUVERTURE POUR ICI.
         Il installe la version LOCALE (npm, Node.js), pas la même chose que les
         trois cartes au-dessus : la question n'est plus « qu'est-ce que
         SuperPrint » mais « et si je veux le poste chez moi ». Les deux routes
         menaient au même logiciel depuis deux endroits sans se parler.
         La classe s'appelait `hero-install` : le nom disait le lieu. -->
    <div class="lg-install">
      <div class="install-shell">
        <div class="install-head">
          <div class="inst-title">
            <svg viewBox="0 0 24 24"><path d="M4 17l6-6-6-6"></path><path d="M12 19h8"></path></svg>
            <span data-lang="fr">Installer SuperPrint en local</span>
            <span data-lang="en">Install SuperPrint locally</span>
            <span data-lang="ja">SuperPrintをローカルにインストール</span>
          </div>
        </div>
        <p class="inst-desc" data-lang="fr">Copiez cette ligne dans votre terminal : elle télécharge le paquet, installe puis lance l'application sur votre machine.</p>
        <p class="inst-desc" data-lang="en">Copy this line into your terminal: it downloads the package, installs and launches the app on your machine.</p>
        <p class="inst-desc" data-lang="ja">この行をターミナルにコピーしてください。パッケージをダウンロードし、インストールしてアプリを起動します。</p>
        <div class="cmd-block">
          <span id="osIcon" class="cmd-os-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:currentColor;"><rect x="0" y="0" width="10.5" height="10.5"></rect><rect x="13.5" y="0" width="10.5" height="10.5"></rect><rect x="0" y="13.5" width="10.5" height="10.5"></rect><rect x="13.5" y="13.5" width="10.5" height="10.5"></rect></svg>
          </span>
          <code id="installCmd">npx.cmd superprint</code>
          <button type="button" class="copy-btn" data-copy="installCmd">
            <svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span data-lang="fr">Copier</span><span data-lang="en">Copy</span><span data-lang="ja">コピー</span>
          </button>
        </div>
        <div class="cmd-meta">
          <div class="cmd-tabs">
            <button class="cmd-tab active" data-os="win" type="button">Windows</button>
            <button class="cmd-tab" data-os="mac" type="button">macOS</button>
            <button class="cmd-tab" data-os="linux" type="button">Linux</button>
          </div>
          <span class="cmd-hint" id="installHint">PowerShell · npx.cmd bypasses the script ExecutionPolicy block</span>
        </div>
        <div class="install-note">
          <span class="assure inline-fr">Sans abonnement</span>
          <span class="assure inline-en">No subscription</span>
          <span class="assure inline-ja">サブスク不要</span>
          <span class="assure inline-fr">Fonctionne hors-ligne</span>
          <span class="assure inline-en">Works offline</span>
          <span class="assure inline-ja">オフラインで動作</span>
          <span class="assure inline-fr">Aussi en application PWA</span>
          <span class="assure inline-en">Also a PWA app</span>
          <span class="assure inline-ja">PWA アプリとしても</span>
        </div>
      </div>
    </div>
  </div>
</section>
