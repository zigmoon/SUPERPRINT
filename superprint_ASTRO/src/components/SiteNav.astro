---
/**
 * Barre de navigation principale : logo, cinq entrées, le menu « Télécharger »
 * et les outils de langue.
 *
 * Les entrées viennent de `src/data/site.ts` ; seules varient selon la page
 * l'ancre du logo (`#hero` sur l'accueil) et l'entrée marquée « page courante ».
 *
 * 🆕 v1.7.612 — « TÉLÉCHARGER » A REMPLACÉ « OUVRIR L'APP ». La barre servait à
 * ENTRER dans l'application ; elle sert maintenant à L'INSTALLER. L'entrée
 * « Ouvrir en ligne » reste, un cran plus bas dans le menu : rien n'est perdu.
 *
 * LES INSTALLEURS SONT ICI, ET NULLE PART AILLEURS. Le bloc « télécharger » qui
 * vivait sous les trois entrées de l'accueil a été retiré : cinq liens répétés
 * deux fois, c'était un doublon à tenir à jour. Ce menu est désormais la seule
 * adresse des fichiers.
 *
 * IL VIT DANS `.nav-links`, À LA PLACE DE L'ANCIEN APPEL À L'ACTION :
 * placé dans `.nav-tools`, le bouton glissait de 277 px vers la droite
 * (mesuré), la barre répartissant ses groupes en `space-between`. Sous
 * 1000 px, SEULS SES LIENS DE TEXTE disparaissent (`.nav-links > a`), pas
 * lui : le téléchargement reste atteignable au doigt.
 */
import { DESKTOP_APPLICATIONS, DESKTOP_DOWNLOADS, DOWNLOAD_LABELS, MARKUP_LANG_ORDER, NAV_ITEMS, VERSION, urlTelechargement } from '../data/site';

interface Props {
  /** `href` de l'entrée à marquer active, ou `null`. */
  active?: string | null;
  /** Cible du logo : `#hero` sur l'accueil, `index.html` ailleurs. */
  logoHref?: string;
  /** Ancre de la première entrée : `#features` sur l'accueil. */
  featuresHref?: string;
}

const {
  active = null,
  logoHref = 'index.html',
  featuresHref = 'index.html#features',
} = Astro.props;

const items = NAV_ITEMS.map((item, i) => ({
  ...item,
  href: i === 0 ? featuresHref : item.href,
}));

/**
 * Les marques des trois systèmes — Windows, Apple, Linux. Des FICHIERS, et non
 * des tracés en ligne : le Tux officiel pèse cinq kilomètres de courbes, et il
 * serait recopié trois fois par page. Ce sont les marques réelles, et non des
 * pictogrammes : ici on cherche un système, pas un objet.
 */
const ICONES: Record<string, string> = {
  win: 'icons/windows.svg',
  mac: 'icons/macos.svg',
  linux: 'icons/linux.svg',
};

---

<!-- ══════════════ NAVIGATION ══════════════ -->
<nav>
  <a class="nav-logo" href={logoHref}>
    SUPER<span>PRINT</span>
  </a>
  <div class="nav-links">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={[item.href === active ? 'active' : null]}
        aria-current={item.href === active ? 'page' : undefined}
      >
        {MARKUP_LANG_ORDER.map((lang) => (
          <span class={`inline-${lang}`}>{item.label[lang]}</span>
        ))}
      </a>
    ))}

    <!-- 🆕 v1.7.613 — LE MENU RESTE DANS `.nav-links`, À LA PLACE QU'OCCUPAIT
         « Ouvrir l'app ». La barre répartit ses trois groupes en
         `space-between` : placé dans `.nav-tools`, le bouton glissait de 277 px
         vers la droite (mesuré sur une fenêtre de 1400 : son bord gauche passe
         de ~808 à 1085). Ici, il garde exactement la position de l'appel à
         l'action qu'il remplace.

         SOUS 1000 px, `.nav-links` n'est plus masqué en bloc : les cinq entrées
         de TEXTE disparaissent, le menu reste (voir la règle mobile, dans les
         feuilles de page).

         Panneau de DIVULGATION, pas menu ARIA : des liens, un bouton, Échap pour
         fermer. Le `padding-top` du panneau est un PONT transparent — sans lui, le
         survol se coupe entre le bouton et la carte et le menu se referme au moment
         où l'on veut cliquer. La bascule est dans le script de la page
         (`JS/pages/<page>/0-language-switcher.js`, extrait du `<script>` en ligne
         par `tools/legacy-migration/convert.mjs`). ⚠️ Elle vivait auparavant dans
         un fichier PARTAGÉ (`JS/marketing/lang-switcher.js`) ; le script de chaque
         page a divergé depuis, donc elles sont désormais extraites page par page
         et le fichier partagé n'existe plus. -->
    <div class="nav-dd" data-nav-dd>
      <button type="button" class="nav-dd-btn" id="navDlBtn" aria-expanded="false" aria-controls="navDlPanel">
        {MARKUP_LANG_ORDER.map((lang) => (
          <span class={`inline-${lang}`}>{DOWNLOAD_LABELS.bouton[lang]}</span>
        ))}
        <svg class="nav-dd-dl" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5v11.5"/><path d="M7.4 10.4l4.6 4.6 4.6-4.6"/><path d="M4.5 20.5h15"/></svg>
        <svg class="nav-dd-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="nav-dd-panel" id="navDlPanel">
        <div class="nav-dd-boite">
          <p class="nav-dd-tete">
            {MARKUP_LANG_ORDER.map((lang) => (
              <span data-lang={lang}>{DOWNLOAD_LABELS.titre[lang]}</span>
            ))}
            <span class="nav-dd-sous">
              {MARKUP_LANG_ORDER.map((lang) => (
                <span class={`inline-${lang}`}>{DOWNLOAD_LABELS.sous[lang]}</span>
              ))}
            </span>
          </p>
          <!-- Les neuf installeurs sont ICI, et nulle part ailleurs dans le site.
               Un SYSTÈME par ligne, et sous chacun les trois applications — dont
               le nom ne porte plus le lien. Chaque fichier porte le sien : avec
               trois applications et jusqu'à trois formats par système, un nom
               cliquable serait ambigu, et l'`::after` qui étirait son lien sur
               toute la ligne recouvrirait les deux lignes suivantes. -->
          <div class="nav-dd-liste">
            {DESKTOP_DOWNLOADS.map((item) => (
              <div class="nav-dd-item">
                <span class="nav-dd-ic" aria-hidden="true">
                  <img src={ICONES[item.os]} alt="" width="26" height="26" loading="lazy" decoding="async" />
                </span>
                <span class="nav-dd-txt">
                  <span class="nav-dd-os">{item.nom}</span>
                  <span class="nav-dd-apps">
                    {DESKTOP_APPLICATIONS.map((app) => (
                      <span class="nav-dd-app">
                        {/* 🆕 v1.7.668 — LE NOM ET LA VERSION SONT GROUPÉS. La barre
                            du site affiche « SuperPrint v1.7.668 » dans le menu de
                            téléchargement (`nav-dd-app-id` > `nav-dd-app-nom` +
                            `nav-dd-app-ver`), pour que le visiteur sache QUELLE
                            version il installe avant de cliquer. Ce composant ne
                            produisait que le nom : `verify.mjs` comptait donc neuf
                            `nav-dd-app-id` et neuf `nav-dd-app-ver` PERDUS sur
                            chaque page. On reproduit la structure du balisage
                            d'origine, wrapper compris. */}
                        <span class="nav-dd-app-id">
                          <span class="nav-dd-app-nom">{app.nom}</span>
                          <span class="nav-dd-app-ver">v{VERSION}</span>
                        </span>
                        <span class="nav-dd-app-fmt">
                          {item.paquets.map((paquet) => (
                            <a href={urlTelechargement(app, paquet)} rel="noopener">{paquet.label}</a>
                          ))}
                        </span>
                      </span>
                    ))}
                  </span>
                </span>
              </div>
            ))}
          </div>
          <div class="nav-dd-pied">
            <a href="app/index.html">
              {MARKUP_LANG_ORDER.map((lang) => (
                <span class={`inline-${lang}`}>{DOWNLOAD_LABELS.enLigne[lang]}</span>
              ))}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="nav-tools">
    <div class="lang-toggle">
      <button id="btn-en" class="active" onclick="setLang('en')">EN</button>
      <button id="btn-fr" onclick="setLang('fr')">FR</button>
      <button id="btn-ja" onclick="setLang('ja')">JA</button>
    </div>
    <button type="button" class="nav-burger" id="navBurger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
