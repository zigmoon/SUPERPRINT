    <!-- 8 · LES OUTILS, UN PAR UN — replié : les captures d'écran -->
    <details class="spf-fold" id="planches" data-chapitre="planches">
        <summary class="spf-bar">
          <div class="spf-k"><span data-lang="fr">Une capture par outil</span><span data-lang="en">One capture per tool</span><span data-lang="ja">道具ごとの画面</span></div>
          <div class="spf-t"><h3 data-lang="fr">Les outils, un par un.</h3><h3 data-lang="en">The tools, one by one.</h3><h3 data-lang="ja">道具をひとつずつ。</h3></div>
