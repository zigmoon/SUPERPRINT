const headExtra = "<!-- 🆕 v1.7.495 — LA BARRE DU NAVIGATEUR EN NOIR SUR TÉLÉPHONE.\r\n     Dans Chrome (Android) et Safari (iOS), la barre du navigateur prend la couleur déclarée ici.\r\n     Sur téléphone cette page est demandée en NOIR (la bande quadri, le logotype et la barre\r\n     collante se détachent alors du cadre du navigateur), et en papier au-delà de 1000 px.\r\n     L'ordre compte : le noir est déclaré SANS attribut « media », donc tout navigateur qui ne\r\n     sait pas lire cet attribut (Safari) prend celui-là — c'est le noir qui gagne sur mobile,\r\n     où il est justement demandé. Chrome, lui, évalue les deux : il garde la dernière déclaration\r\n     dont la condition est vraie, donc le papier sur grand écran. -->\n\n<!-- GEO -->\n\n<!-- Canonical + hreflang — 🆕 v1.7.468 : une URL par langue.\r\n     /  = anglais (langue par défaut de la page, <html lang=\"en\">)\r\n     /?lang=fr = français · /?lang=ja = japonais · x-default = /\r\n     setLang() met canonical et og:url à jour pour rester cohérent. -->\n\n<!-- Open Graph -->\n\n<!-- Twitter/X -->\n\n<!-- JSON-LD — SoftwareApplication + FAQPage + BreadcrumbList -->\n\n<link rel=\"icon\" type=\"image/png\" href=\"favicon.png\">\r\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"favicon.png\">\r\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"favicon.png\">\r\n<link rel=\"icon\" type=\"image/png\" sizes=\"96x96\" href=\"icons/icon-96x96.png\">\r\n<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"icons/icon-192x192.png\">\r\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"icons/icon-192x192.png\">\r\n<!-- Local self-hosted IBM Plex Mono + Sans (no Google Fonts CDN) -->\r\n<!-- 🆕 v1.7.477 — LES DEUX POLICES CRITIQUES SONT PRÉCHARGÉES.\r\n     « Bebas Neue » (le mot SUPERPRINT de la barre) et « Playfair Display » (les grands titres)\r\n     sont en « font-display: swap » : sans préchargement, le navigateur peint d'abord une police\r\n     de repli — le mot apparaît dans une autre typo, plus claire — puis la remplace dès que le\r\n     fichier arrive. Le préchargement les fait partir AVEC le HTML, donc à la première peinture.\r\n     « crossorigin » est obligatoire : les polices sont toujours demandées en CORS. -->\r\n<link rel=\"preload\" href=\"CSS/fonts/BebasNeue-400-normal-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\r\n<link rel=\"preload\" href=\"CSS/fonts/PlayfairDisplay-400-normal-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\r\n<link rel=\"stylesheet\" href=\"CSS/fonts.css\">";
