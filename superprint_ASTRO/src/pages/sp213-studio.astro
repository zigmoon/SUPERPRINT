<Fragment set:html={"<!-- 🆕 v1.7.420 — POP-IN « RÔLE DE LA PIÈCE JOINTE » (à l'import) : contenu à placer,\n     modèle de structure à suivre, ou contexte pour la compréhension seulement. -->"} />
<div id="pjModal" class="pj-overlay hidden" role="dialog" aria-modal="true">
  <div class="pj-card">
    <div class="pj-head"><span class="pj-title" id="pjTitle"></span><span class="pj-sub" id="pjSub"></span></div>
    <div class="pj-opts" id="pjOpts"></div>
    <div class="pj-foot"><button class="btn" id="pjCancel" type="button"></button><button class="btn btn-primary" id="pjOk" type="button"></button></div>
  </div>
</div>

<Fragment set:html={"<!-- ⚠️ _SP_STUDIO_ROCK610 — LE CLAVIER À L'ÉCRAN EST SUPPRIMÉ (bouton, voile et panneau) :\n     demande utilisateur « supprime l'icône clavier (et la fonction) dans les deux cas ».\n     La dictée vocale du micro est conservée. -->"} />
<Fragment set:html={"<!-- ══ _SP_STUDIO_REGLAGES_586 — POP-IN RÉGLAGES (refactorisation en direct) ══\n     Il se pose SUR la colonne de conversation (la preview reste visible à gauche) :\n     les tirettes recomposent le document en direct, « Valider » referme et rend la\n     conversation avec le compte rendu des réglages appliqués. -->"} />
<div id="spReg" class="hidden" role="dialog" aria-modal="true" aria-label="Réglages de la maquette">
  <div class="rg-head">
    <div>
      <div class="rg-t" data-i18n="reg.titre">Réglages de la maquette</div>
      <div class="rg-s" id="rgSub" data-i18n="reg.sous">Refactorisation en direct : le document se recompose pendant que vous bougez les tirettes. Réservé à SP213 rock 1.0.</div>
    </div>
    <button class="rg-close" id="rgClose" title="Fermer" aria-label="Fermer" data-i18n-title="reg.fermer" data-i18n-aria="reg.fermer">✕</button>
  </div>
  <div class="rg-body" id="rgBody"></div>
  <div class="rg-foot">
    <span class="rg-busy" id="rgBusy"></span>
    <!-- 🆕 v1.7.581 — LE BOUTON « VARIATION » EST RETIRÉ (demande utilisateur : « supprime
         le bouton VARIATION qui est à gauche du bouton annuler »). La variation reste
         réglable par la tirette « Jeu n° » du panneau ; le pied ne garde que l'essentiel. -->
    <button class="btn btn-secondary" id="rgCancel" type="button" data-i18n="reg.annuler">Annuler</button>
    <button class="btn btn-primary" id="rgOk" type="button" data-i18n="reg.valider">Valider</button>
  </div>
</div>
</MinimalLayout>
