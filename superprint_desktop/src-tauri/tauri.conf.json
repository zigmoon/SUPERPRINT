{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperPrint",
  "version": "1.7.611",
  "identifier": "cc.superprint.desktop",
  "build": {
    "frontendDist": "../../superprint/app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SuperPrint",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "PAO professionnelle dans le navigateur.",
    "longDescription": "SuperPrint — logiciel de publication assistée par ordinateur (PAO) avec Studio IA SP213 et SuperTyPo. Application de bureau autonome, fonctionne hors-ligne.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Zigmoon — Simon Dupont-Gellert & Clémence Brunet",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
