{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperPrint",
  "version": "1.7.654",
  "identifier": "cc.superprint.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-bundle.mjs",
    "frontendDist": "../frontend/superprint"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperPrint",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false,
        "url": "app/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "copyright": "© Zigmoon — Simon Dupont-Gellert & Clémence Brunet",
    "publisher": "Zigmoon",
    "homepage": "https://superprint.cc",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/superprint/32x32.png",
      "icons/superprint/128x128.png",
      "icons/superprint/128x128@2x.png",
      "icons/superprint/icon.icns",
      "icons/superprint/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French", "English", "Japanese"],
        "installerIcon": "icons/superprint/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [],
        "section": "graphics"
      }
    }
  }
}
