# Dépendances Node (CLI Tauri)
node_modules/

# Dossier embarqué par Tauri, FABRIQUÉ par `scripts/prepare-bundle.mjs` à partir
# de `../superprint/` : ~69 Mo recopiés, jamais versionnés.
frontend/

# Sortie de compilation Rust
src-tauri/target/
src-tauri/gen/

# Journal et copyright du .deb — FABRIQUÉS par `scripts/prepare-bundle.mjs`, un
# par application. Le copyright est assemblé depuis le `LICENSE` du dépôt,
# précisément pour que le texte de la licence ne puisse pas diverger du vrai.
src-tauri/changelog-*.gz
src-tauri/copyright-*

# Scripts de retrait des paquets Linux (postrm Debian, postun RPM) — FABRIQUÉS
# eux aussi, un par application et par format : ils portent l'identifiant de
# l'application, qui n'est pas le même dans les trois paquets.
src-tauri/postremove-*.sh
src-tauri/desinstaller-macos-*.command

# Artefacts de distribution
dist/
